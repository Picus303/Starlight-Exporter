  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StarlightExporter.StarlightTarget/StarlightExporter.StarlightTarget.csproj" />
    <ProjectReference Include="../StarlightExporter.Persistence/StarlightExporter.Persistence.csproj" />
    <ProjectReference Include="../StarlightExporter.Snapshot/StarlightExporter.Snapshot.csproj" />
  </ItemGroup>
</Project>
