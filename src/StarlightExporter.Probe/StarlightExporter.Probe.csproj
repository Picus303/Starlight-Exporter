<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StarlightExporter.Official/StarlightExporter.Official.csproj" />
    <ProjectReference Include="../StarlightExporter.Cli/StarlightExporter.Cli.csproj" />
    <PackageReference Include="System.Management" Version="9.0.5" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StarlightExporter.OfficialTests" />
  </ItemGroup>
</Project>
